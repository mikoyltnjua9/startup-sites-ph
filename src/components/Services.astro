---
import CloudLayer from './CloudLayer.astro';

const webDevTiers = [
  {
    name: 'Basic Design',
    price: '₱7,999',
    unit: '',
    desc: 'A clean, custom site for businesses that just need a solid start.',
    features: [
      'Up to 5 pages',
      'Custom layout design',
      'Mobile responsive design',
      'Basic UI style guide',
      'Delivery: 7-10 days',
    ],
    footnote: 'For a straightforward site with no extra complexity.',
    cta: 'Get Started',
    featured: false,
  },
  {
    name: 'Business Design',
    price: '₱9,999',
    unit: '',
    desc: 'A more complete design for businesses ready to stand out.',
    features: [
      'Up to 7 pages',
      'Custom UI/UX design',
      'Mobile and tablet responsive',
      'Design handed off development ready',
      'Revisions included',
      'Delivery: 14-18 days',
    ],
    footnote: 'Our most requested package.',
    cta: 'Get Started',
    featured: true,
  },
  {
    name: 'Premium Design',
    price: '₱11,999',
    unit: '',
    desc: 'High end, fully custom design for larger or more complex sites.',
    features: [
      'Up to 12 pages',
      'High end custom design',
      'Advanced UI/UX and animations',
      'Design system and components',
      'Unlimited revisions',
      'Delivery: 20-25 days',
    ],
    footnote: 'For projects that go beyond the basics.',
    cta: 'Book a Call',
    featured: false,
  },
];

const seoTiers = [
  {
    name: 'Basic',
    price: '₱1,500',
    unit: '/ month',
    desc: 'For small sites just getting started with search visibility.',
    features: [
      'Keyword research (5 keywords)',
      '5 blog posts per month',
      'Google Search Console setup',
      'Monthly performance report',
    ],
    footnote: 'A steady starting point for organic search.',
    cta: 'Get Started',
    featured: false,
  },
  {
    name: 'Intermediate',
    price: '₱3,200',
    unit: '/ month',
    desc: 'For businesses ready to actively grow organic traffic.',
    features: [
      'Keyword research (15 keywords)',
      '10 blog posts per month',
      '5 forums participation',
      'Google Search Console setup',
      'Monthly performance report',
    ],
    footnote: 'Our most requested SEO package.',
    cta: 'Get Started',
    featured: true,
  },
  {
    name: 'Expert',
    price: '₱5,000+',
    unit: '/ month',
    desc: 'For competitive markets that need consistent, aggressive growth.',
    features: [
      'Keyword research (30 keywords)',
      '15 blog posts per month',
      '10 forums participation',
      'Site audit',
      '3-5 link building (additional budget)',
      'Google Search Console setup',
      'Monthly performance report',
    ],
    footnote: 'For businesses ready to lead their category.',
    cta: 'Book a Call',
    featured: false,
  },
];
---

<section class="services section" id="services">
  <CloudLayer />
  <div class="section-inner">
    <p class="eyebrow-warm" data-reveal><span class="eyebrow-dot"></span>Services</p>
    <h2 class="services-title warm-title" data-reveal>Same standard,<br />sized to what you need now.</h2>

    <div class="service-tabs" role="tablist" data-reveal>
      <button type="button" class="service-tab is-active" data-tab-btn="webdev" role="tab" aria-selected="true">
        Web Development
      </button>
      <button type="button" class="service-tab" data-tab-btn="seo" role="tab" aria-selected="false">
        SEO
      </button>
    </div>

    <div class="tier-grid" data-tab-panel="webdev">
      {
        webDevTiers.map((t) => (
          <article class:list={['tier-card', { 'tier-card--featured': t.featured }]} data-reveal>
            {t.featured && <span class="tier-flag">Most Booked</span>}
            <h3>{t.name}</h3>
            <p class="tier-price">
              {t.price}
              {t.unit && <span>{t.unit}</span>}
            </p>
            <p class="tier-desc">{t.desc}</p>
            <ul class="tier-features">
              {t.features.map((f) => (
                <li>{f}</li>
              ))}
            </ul>
            <p class="tier-footnote">{t.footnote}</p>
            <a
              class:list={[
                'btn-warm',
                'tier-cta',
                t.featured ? 'btn-warm--primary' : 'btn-warm--ghost',
              ]}
              href="/contact"
            >
              {t.cta}
            </a>
          </article>
        ))
      }
    </div>

    <div class="tier-grid" data-tab-panel="seo" hidden>
      {
        seoTiers.map((t) => (
          <article class:list={['tier-card', { 'tier-card--featured': t.featured }]}>
            {t.featured && <span class="tier-flag">Most Booked</span>}
            <h3>{t.name}</h3>
            <p class="tier-price">
              {t.price}
              {t.unit && <span>{t.unit}</span>}
            </p>
            <p class="tier-desc">{t.desc}</p>
            <ul class="tier-features">
              {t.features.map((f) => (
                <li>{f}</li>
              ))}
            </ul>
            <p class="tier-footnote">{t.footnote}</p>
            <a
              class:list={[
                'btn-warm',
                'tier-cta',
                t.featured ? 'btn-warm--primary' : 'btn-warm--ghost',
              ]}
              href="/contact"
            >
              {t.cta}
            </a>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .services {
    position: relative;
    background: var(--a-bg);
  }

  .services-title {
    font-size: clamp(1.9rem, 4vw, 3rem);
    margin-top: 1rem;
    max-width: 18ch;
  }

  .service-tabs {
    display: inline-flex;
    gap: 0.3rem;
    margin-top: clamp(2rem, 4vw, 3rem);
    padding: 0.3rem;
    border-radius: 999px;
    background: var(--a-card);
    box-shadow: 0 16px 36px -30px var(--a-shadow);
  }

  .service-tab {
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 0.9rem;
    color: var(--a-muted);
    background: none;
    border: none;
    border-radius: 999px;
    padding: 0.7rem 1.4rem;
    transition:
      background 0.25s ease,
      color 0.25s ease;
  }

  .service-tab.is-active {
    background: var(--a-coral);
    color: #fff;
  }

  .tier-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
    margin-top: clamp(2rem, 4vw, 3rem);
    align-items: stretch;
  }

  /* The [hidden] attribute's default display:none comes from the browser's
     UA stylesheet, which the plain .tier-grid rule above (author CSS)
     silently overrides regardless of specificity — author styles always
     beat UA defaults. This re-asserts it with a selector specific enough
     to win back. */
  .tier-grid[hidden] {
    display: none;
  }

  .tier-card {
    position: relative;
    padding: 2rem;
    display: flex;
    flex-direction: column;
    background: var(--a-card);
    border-radius: 28px;
    box-shadow: 0 20px 45px -30px var(--a-shadow);
  }

  .tier-card--featured {
    box-shadow: 0 30px 60px -30px rgba(255, 107, 91, 0.35);
    outline: 2px solid var(--a-coral);
    outline-offset: -2px;
  }

  .tier-flag {
    position: absolute;
    top: -0.75rem;
    left: 2rem;
    background: var(--a-coral);
    color: #fff;
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 0.65rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 0.3rem 0.75rem;
    border-radius: 999px;
  }

  .tier-card h3 {
    font-family: var(--font-display-warm);
    font-weight: 700;
    font-size: 1.15rem;
    color: var(--a-ink);
  }

  .tier-price {
    font-family: var(--font-display-warm);
    font-weight: 800;
    font-size: 2rem;
    margin-top: 0.75rem;
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    color: var(--a-ink);
  }

  .tier-price span {
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 400;
    color: var(--a-muted);
  }

  .tier-desc {
    margin-top: 1rem;
    font-family: var(--font-body);
    color: var(--a-muted);
    line-height: 1.55;
    font-size: 0.92rem;
  }

  .tier-features {
    list-style: none;
    margin: 1.5rem 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    flex: 1;
  }

  .tier-features li {
    font-family: var(--font-body);
    color: var(--a-ink);
    font-size: 0.88rem;
    line-height: 1.4;
    padding-left: 1.2rem;
    position: relative;
  }

  .tier-features li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.45em;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--a-coral);
  }

  .tier-footnote {
    font-family: var(--font-body);
    font-size: 0.8rem;
    color: var(--a-muted);
    margin-top: 1.5rem;
  }

  .tier-cta {
    margin-top: 1.5rem;
    width: 100%;
    text-align: center;
  }
</style>
