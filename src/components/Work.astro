---
import CloudLayer from './CloudLayer.astro';

const accents = ['coral', 'blue', 'mint', 'yellow', 'lavender'] as const;

const projects = [
  {
    num: '01',
    tags: ['Web Design', 'Rental'],
    name: 'Sweeney Properties',
    url: 'https://sweeneyleasing.com/',
    blurb: 'A rental property leasing site built to showcase available units and make inquiries easy.',
    shot: 'sweeney-properties',
  },
  {
    num: '02',
    tags: ['Web Design', 'Construction'],
    name: 'Vetmax Construction',
    url: 'https://vetmaxconstruction.com/',
    blurb: 'A construction company site built to showcase past projects and bring in new leads.',
    shot: 'vetmax-construction',
  },
  {
    num: '03',
    tags: ['Web Design', 'Accounting'],
    name: 'DDC Consulting Inc.',
    url: 'https://ddcconsultinginc.com/',
    blurb: 'An accounting firm site built around clarity, trust, and easy client onboarding.',
    shot: 'ddc-consulting',
  },
  {
    num: '04',
    tags: ['Web Design', 'Retail'],
    name: 'Fujifilm-X',
    url: 'https://www.fujifilm-x.com/en-ph/',
    blurb: 'A regional site for the Fujifilm X series camera lineup.',
    shot: 'fujifilm',
  },
  {
    num: '05',
    tags: ['Web Design', 'SEO'],
    name: 'Web To Support',
    url: 'https://webtosupport.com/',
    blurb: 'A lead generation website built around SEO performance for an IT support company.',
    shot: 'webtosupport',
  },
  {
    num: '06',
    tags: ['Ecommerce', 'Retail'],
    name: 'Rally Sports PH',
    url: 'https://rallysportsph.com/',
    blurb: 'An online store for a badminton and pickleball retailer, built to move product online.',
    shot: 'rallysports',
  },
  {
    num: '07',
    tags: ['Web Design', 'Legal'],
    name: 'LA Attorney',
    url: 'https://laattorney.com/',
    blurb: 'A law firm site built to establish credibility and convert visitors into consultations.',
    shot: 'la-attorney',
  },
].map((p, i) => ({ ...p, accent: accents[i % accents.length] }));
---

<section class="work" id="work">
  <CloudLayer />
  <div class="work-head section-inner">
    <p class="eyebrow-warm" data-reveal><span class="eyebrow-dot"></span>Selected Work</p>
    <h2 class="work-title warm-title" data-reveal>Built to launch,<br />made to perform.</h2>
    <p class="work-sub" data-reveal>
      A few of the businesses we have built and launched sites for, across
      web design, ecommerce, and SEO.
    </p>
  </div>

  <div class="work-viewport" data-work-viewport>
    <ul class="work-track" data-work-track>
      {
        projects.map((p) => (
          <li class={`work-card work-card--${p.accent}`} data-work-card>
            <a
              class="work-card-link"
              href={p.url}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`Visit ${p.name} (opens in a new tab)`}
            />
            <div class="work-card-bg" aria-hidden="true">
              <div class="work-card-blob work-card-blob--a" />
              <div class="work-card-blob work-card-blob--b" />
              <div class="work-card-blob work-card-blob--c" />
            </div>
            <div class="work-card-overlay" aria-hidden="true" />

            <div class="work-card-top">
              <span class="work-num">{p.num}</span>
              <ul class="work-tags">
                {p.tags.map((t) => (
                  <li>{t}</li>
                ))}
              </ul>
            </div>

            <div class="device-wrap">
              <div class="device">
                <div class="device-screen">
                  <img
                    class="device-shot"
                    data-device-shot
                    src={`/work/${p.shot}.webp`}
                    alt=""
                    loading="lazy"
                  />
                  <div class="device-hint" aria-hidden="true">Hover to preview</div>
                </div>
                <div class="device-stand" aria-hidden="true">
                  <i />
                  <b />
                </div>
              </div>
            </div>

            <div class="work-card-foot">
              <h3>{p.name}</h3>
              <p>{p.blurb}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .work {
    position: relative;
    background: var(--a-bg);
    color: var(--a-ink);
    height: 100svh;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 1.25rem 0;
  }

  .work-head {
    /* .section-inner's shared `margin: 0 auto` centers a max-width block in
       normal flow, but inside .work's flex column it instead triggers
       flexbox's auto-margin rule (shrink-to-fit-content + center) instead of
       stretching full width like every other section. Neither margin below
       is `auto`, which sidesteps that — but that also means the sidebar
       clearance section-inner normally provides via its own auto-margin
       trick needs to be re-applied explicitly here (>=900px only, to match
       where the sidebar actually exists). */
    margin-left: 0;
    margin-right: 0;
    padding-bottom: 1.25rem;
    flex-shrink: 0;
  }

  @media (min-width: 900px) {
    .work-head {
      margin-left: var(--rig-w);
    }
  }

  .work-title {
    font-size: clamp(1.5rem, 2.6vw, 2.25rem);
    margin-top: 0.5rem;
    max-width: 16ch;
  }

  .work-sub {
    font-family: var(--font-body);
    color: var(--a-muted);
    max-width: 48ch;
    margin-top: 0.65rem;
    line-height: 1.5;
    font-size: 0.92rem;
  }

  .work-viewport {
    overflow-x: auto;
    scroll-snap-type: x proximity;
    scrollbar-width: none;
    cursor: grab;
    /* Let vertical swipes fall through to normal page scroll; horizontal
       motion is handled entirely by the JS pointer-drag handler instead of
       native touch-scroll, which was fighting the page's vertical scroll
       on some mobile browsers inside this height:100svh section. */
    touch-action: pan-y;
  }

  .work-viewport::-webkit-scrollbar {
    display: none;
  }

  .work-viewport.is-dragging {
    cursor: grabbing;
    scroll-snap-type: none;
    user-select: none;
  }

  /* Hidden (not visible) while pinned: cards translate horizontally right
     underneath the fixed sidebar over the course of the whole scroll-jack,
     not just at the starting position — the viewport's own box (offset
     below) needs to actually clip them there, not just rely on the
     sidebar's z-index painting over whatever happens to be behind it. */
  .work-viewport.is-pinned {
    overflow: hidden;
    cursor: default;
    touch-action: auto;
  }

  @media (min-width: 900px) {
    .work-viewport {
      margin-left: var(--rig-w);
      width: calc(100% - var(--rig-w));
    }
  }

  .work-track {
    list-style: none;
    margin: 0;
    padding: 0 var(--edge);
    display: flex;
    gap: 1.5rem;
    width: max-content;
  }

  .work-card {
    position: relative;
    scroll-snap-align: start;
    flex: 0 0 480px;
    width: 480px;
    height: 680px;
    background: #242426;
    border-radius: 28px;
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  /* Per-card accent tint for the lava-lamp blobs below, set once here
     rather than repeated on every descendant that needs it. */
  .work-card--coral {
    --card-accent: rgba(255, 107, 91, 0.65);
  }
  .work-card--blue {
    --card-accent: rgba(77, 163, 255, 0.65);
  }
  .work-card--mint {
    --card-accent: rgba(52, 199, 154, 0.65);
  }
  .work-card--yellow {
    --card-accent: rgba(255, 201, 77, 0.65);
  }
  .work-card--lavender {
    --card-accent: rgba(155, 140, 255, 0.65);
  }

  /* Sits above every other layer so the whole card is one click target,
     but paints nothing itself — the drag-vs-click guard already built into
     initWorkDrag (site.ts) suppresses this link's navigation when the
     pointer actually dragged the track instead of clicking. */
  .work-card-link {
    position: absolute;
    inset: 0;
    z-index: 5;
    cursor: pointer;
  }

  .work-card-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
  }

  /* Lava-lamp blobs — soft, blurred, glowing circles that wander slowly
     around the card, tinted to that card's own accent color. Each blob
     gets its own keyframes (rather than sharing one) so the three drift
     on independent, non-repeating-looking paths instead of moving in
     lockstep. */
  .work-card-blob {
    position: absolute;
    border-radius: 50%;
    background: var(--card-accent);
    filter: blur(50px);
    mix-blend-mode: screen;
    will-change: transform;
  }

  .work-card-blob--a {
    width: 260px;
    height: 260px;
    top: 8%;
    left: -15%;
    animation: work-blob-a 17s ease-in-out infinite;
  }

  .work-card-blob--b {
    width: 210px;
    height: 210px;
    top: 52%;
    right: -15%;
    animation: work-blob-b 20s ease-in-out infinite;
    animation-delay: -5s;
  }

  .work-card-blob--c {
    width: 190px;
    height: 190px;
    bottom: -8%;
    left: 18%;
    animation: work-blob-c 23s ease-in-out infinite;
    animation-delay: -11s;
  }

  @keyframes work-blob-a {
    0%,
    100% {
      transform: translate(0, 0) scale(1);
    }
    25% {
      transform: translate(40px, 50px) scale(1.15);
    }
    50% {
      transform: translate(15px, 110px) scale(0.9);
    }
    75% {
      transform: translate(-25px, 40px) scale(1.05);
    }
  }

  @keyframes work-blob-b {
    0%,
    100% {
      transform: translate(0, 0) scale(1);
    }
    30% {
      transform: translate(-50px, -35px) scale(1.1);
    }
    60% {
      transform: translate(-15px, 50px) scale(0.92);
    }
  }

  @keyframes work-blob-c {
    0%,
    100% {
      transform: translate(0, 0) scale(1);
    }
    35% {
      transform: translate(30px, -60px) scale(1.2);
    }
    70% {
      transform: translate(-20px, -25px) scale(0.9);
    }
  }

  .work-card-overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(
      180deg,
      rgba(29, 29, 31, 0.55) 0%,
      rgba(29, 29, 31, 0.65) 55%,
      rgba(29, 29, 31, 0.92) 100%
    );
  }

  .work-card-top,
  .device-wrap,
  .work-card-foot {
    position: relative;
    z-index: 2;
  }

  .work-card-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
  }

  .work-num {
    font-family: var(--font-display-warm);
    font-weight: 700;
    font-size: 0.9rem;
  }

  .work-card--coral .work-num {
    color: var(--a-coral);
  }
  .work-card--blue .work-num {
    color: var(--a-blue);
  }
  .work-card--mint .work-num {
    color: var(--a-mint);
  }
  .work-card--yellow .work-num {
    color: var(--a-yellow);
  }
  .work-card--lavender .work-num {
    color: var(--a-lavender);
  }

  .work-tags {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
    justify-content: flex-end;
  }

  .work-tags li {
    font-family: var(--font-body);
    font-weight: 500;
    font-size: 0.65rem;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.7);
    background: rgba(255, 255, 255, 0.08);
    border-radius: 999px;
    padding: 0.2rem 0.6rem;
  }

  .device-wrap {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.5rem 0;
  }

  /* Monitor mockup */
  .device {
    position: relative;
    width: 100%;
    max-width: 380px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .device-screen {
    position: relative;
    width: 100%;
    aspect-ratio: 8 / 5;
    background: #1c1c1e;
    border-radius: 14px;
    overflow: hidden;
    box-shadow: 0 24px 40px -26px rgba(0, 0, 0, 0.6);
  }

  .device-stand {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .device-stand i {
    width: 10px;
    height: 20px;
    background: rgba(255, 255, 255, 0.14);
    font-style: normal;
  }

  .device-stand b {
    width: 84px;
    height: 7px;
    border-radius: 4px;
    background: rgba(255, 255, 255, 0.14);
    margin-top: 2px;
    font-weight: normal;
  }

  .device-hint {
    position: absolute;
    inset: auto 0 0.6rem 0;
    text-align: center;
    font-family: var(--font-body);
    font-weight: 500;
    font-size: 0.62rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.55);
    opacity: 1;
    transition: opacity 0.25s;
    pointer-events: none;
  }

  .work-card:hover .device-hint {
    opacity: 0;
  }

  /* Real screenshot, panned into view on hover — same mechanic as the
     Hero's device preview (initDevicePreview in site.ts already targets
     any [data-device-shot] inside a [data-work-card], unchanged). */
  .device-shot {
    position: absolute;
    inset: 0 0 auto 0;
    width: 100%;
    height: auto;
    display: block;
    will-change: transform;
  }

  .work-card-foot {
    margin-top: auto;
    padding-top: 1.5rem;
  }

  .work-card-foot h3 {
    font-family: var(--font-display-warm);
    font-size: 1.1rem;
    font-weight: 700;
    color: #fff;
  }

  .work-card-foot p {
    margin-top: 0.6rem;
    font-family: var(--font-body);
    color: rgba(255, 255, 255, 0.65);
    line-height: 1.55;
    font-size: 0.88rem;
  }
</style>
