---
// Shared decorative background for every non-Hero section: a few cloud
// images that gently bob in place. No horizontal drift, by request.
---

<div class="cloud-layer" aria-hidden="true">
  <img class="cloud cloud--a" src="/icons/cloud-floating.webp" alt="" />
  <img class="cloud cloud--b" src="/icons/cloud-floating.webp" alt="" />
  <img class="cloud cloud--c" src="/icons/cloud-floating.webp" alt="" />
</div>

<style>
  .cloud-layer {
    position: absolute;
    inset: 0;
    overflow: hidden;
    z-index: 0;
    pointer-events: none;
  }

  .cloud {
    position: absolute;
    height: auto;
    opacity: 0.9;
    filter: drop-shadow(0 14px 22px rgba(77, 163, 255, 0.28));
    animation: cloud-float 8.5s ease-in-out infinite;
  }

  .cloud--a {
    width: 190px;
    top: 6%;
    left: 4%;
  }

  .cloud--b {
    width: 130px;
    top: 46%;
    right: 6%;
    animation-duration: 9.5s;
    animation-delay: -3s;
  }

  .cloud--c {
    width: 150px;
    top: 78%;
    left: 12%;
    animation-duration: 7.2s;
    animation-delay: -5.5s;
  }

  @keyframes cloud-float {
    0%,
    100% {
      transform: translateY(0) scale(1);
    }
    50% {
      transform: translateY(-16px) scale(1.02);
    }
  }

  /* Every section puts its eyebrow/heading at the top-left of a much
     shorter box on mobile, so the desktop placement/size above sits right
     on top of that text instead of floating harmlessly in empty space. */
  @media (max-width: 640px) {
    .cloud--a {
      width: 90px;
      top: 32%;
      left: 6%;
    }

    .cloud--b {
      width: 70px;
      top: 58%;
      right: 4%;
    }

    .cloud--c {
      width: 80px;
      top: 80%;
      left: 10%;
    }
  }

  /* Dark mode's darker section backgrounds make the white cloud read as a
     much harsher, more distracting shape than on light backgrounds — dial
     it back rather than changing the light-mode look. */
  :root[data-theme='dark'] .cloud {
    opacity: 0.5;
  }
</style>
